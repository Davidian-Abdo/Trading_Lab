# Copy to .env.shared (no extension change) and fill in.
# Crypto needs Binance Spot Testnet keys (DATA + demo account state).
# Forex needs an OANDA practice token + account id (DATA only, no orders).
# Stocks needs Alpaca paper keys (DATA only, no orders).
# Telegram + heartbeat are optional but recommended.
#
# NEVER commit the real .env.shared. It is in .gitignore for that reason.
# If you ever paste real keys into THIS example file by mistake, ROTATE
# them in the provider dashboard before doing anything else.

# ----- Crypto feed (Binance Spot Testnet — DEMO account) -----
# Register at https://testnet.binance.vision (login with GitHub),
# generate an API key + secret, paste them here. No real money is at
# risk; this is the official Binance demo environment.
BINANCE_TESTNET_KEY=your_binance_testnet_api_key
BINANCE_TESTNET_SECRET=your_binance_testnet_api_secret

# ----- Forex feed (OANDA practice) -----
OANDA_TOKEN=your_oanda_practice_api_token
OANDA_ACCOUNT=your_oanda_practice_account_id

# ----- Stocks feed (Alpaca paper) -----
ALPACA_KEY=your_alpaca_paper_api_key
ALPACA_SECRET=your_alpaca_paper_api_secret

# ----- Optional alerts -----
TG_TOKEN=
TG_CHAT=
HEARTBEAT_URL=

# ----- Dashboard auth (recommended in production) -----
# If set, the Streamlit dashboard prompts for this password before showing
# any data. Leave blank ONLY when the port is firewalled / SSH-tunneled.
DASHBOARD_PASSWORD=

# Copy to .env.shared (no extension change) and fill in.
#
# Crypto  -> Kraken spot (PUBLIC market data; keys OPTIONAL, data only).
# Forex   -> Interactive Brokers PAPER, via a running IB Gateway / TWS.
# Stocks  -> Interactive Brokers PAPER, via the SAME IB Gateway / TWS.
# Telegram + heartbeat are optional but recommended.
#
# NEVER commit the real .env.shared. It is gitignored. If you ever paste
# real keys into THIS example by mistake, ROTATE them immediately.

# ----- Crypto feed (Kraken spot — DATA ONLY) -----
# Kraken has no public spot testnet; the lab uses Kraken LIVE public
# market data and simulates fills per-combo, so no real orders are sent.
# Keys are OPTIONAL (they only raise private rate limits). Leave blank
# for data-only use.
KRAKEN_KEY=
KRAKEN_SECRET=

# ----- Forex + Stocks feed (Interactive Brokers PAPER) -----
# The dockerized IB Gateway (gnzsnz image) reads TWS_USERID / TWS_PASSWORD
# directly. The lab's Python code uses the IB_HOST / IB_PORT / IB_CLIENT_ID_*
# values to connect to that already-logged-in Gateway over the API
# socket. You must run Gateway (or TWS) on a PAPER account with the API
# enabled (Configure -> API -> Settings -> Enable ActiveX/Socket clients)
# and the worker clientIds added to "Trusted IPs"/allowed. For headless
# 24/7, drive Gateway with IBC (the docker-compose ib-gateway service
# does this for you).
#
#   IB_PORT: 4002 = Gateway paper, 7497 = TWS paper
#            (4001 = Gateway live, 7496 = TWS live — DO NOT use)
#   IB_HOST: where Gateway/TWS listens. In the docker-compose layout
#            the lab service overrides this to `ib-gateway` (the gateway
#            container) via the compose network. On bare metal use
#            127.0.0.1, or host.docker.internal if the lab runs in
#            Docker but Gateway runs on the host.
#   IB_MARKET_DATA_TYPE: 3 = delayed (works without a data subscription),
#            4 = delayed-frozen, 1 = live (needs a subscription).
#   The two IB workers (stocks, forex) MUST use different clientIds.
IB_HOST=host.docker.internal
IB_PORT=4002
IB_CLIENT_ID_STOCKS=11
IB_CLIENT_ID_FOREX=12

# Your IBKR PAPER login. These names match the gnzsnz/ib-gateway image
# directly so docker-compose's env_file passes them straight through.
TWS_USERID=
TWS_PASSWORD=

# Optional paper account id (e.g. DUQ123456). Currently informational
# only — the API connection is anonymous against whichever account
# Gateway is logged into.
IB_ACCOUNT=

IB_MARKET_DATA_TYPE=3

# Optional: VNC password for the IB Gateway container (gnzsnz image).
# Lets you VNC into the gateway over an SSH tunnel for ad-hoc debugging
# (login dialogs, etc.). Leave blank to disable the VNC server.
VNC_SERVER_PASSWORD=

# Reuse each (symbol,timeframe,lookback) result for this many seconds.
# The effective TTL is max(IB_CACHE_TTL, POLL_SECONDS, timeframe-floor),
# where the timeframe floor is one bar (5m=300s, 15m=900s, 1h=3600s,...).
# That means a fresh fetch can never happen more often than once per bar,
# so we stay well under IB's ~60 historical requests / 10 min pacing
# limit. Leave at 0 to use the automatic floor.
IB_CACHE_TTL=0

# ----- Optional alerts -----
TG_TOKEN=
TG_CHAT=
HEARTBEAT_URL=

# ----- Test schedule (the experiment window) -----
# Each combo runs in fixed-length windows. End-of-window: any open
# position is closed at the last marked price (reason "window_settle"),
# the realized equity is snapshotted into the `periods` table, and the
# broker resets to start_equity for the next window. Two-to-four weeks
# is the recommended range — long enough to see strategies cycle through
# a few regimes, short enough that the dashboard gets multiple data
# points per combo within a quarter.
TEST_WINDOW_DAYS=14
# Optional: ISO date (YYYY-MM-DD) or datetime for window 0's START. If
# unset, window 0 begins on the first tick the combo runs.
TEST_START_DATE=
# Optional: stop opening fresh windows after this date. The active
# window still settles when its end_ts passes.
TEST_END_DATE=
# Optional: hard cap on the number of windows per combo. Leave blank
# (default) for unlimited.
MAX_WINDOWS=

# ----- Dashboard auth (recommended in production) -----

DASHBOARD_PASSWORD=
